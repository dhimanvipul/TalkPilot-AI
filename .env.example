# TalkPilot AI Configuration Example
# For Vercel Production Deployment, set these in Vercel Project Settings -> Environment Variables

# Server & Database Settings
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/talkpilot?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters

# Telephony Calling Mode ('mock' for zero-cost browser testing, 'real' for actual PSTN phone calls)
CALLING_MODE=mock

# Telephony Provider Configuration
TELEPHONY_PROVIDER=twilio

# Twilio Credentials (REQUIRED only when CALLING_MODE=real)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Public HTTPS Webhook URL (REQUIRED for Twilio status/voice webhooks in real mode)
PUBLIC_WEBHOOK_URL=https://your-talkpilot.vercel.app

# ElevenLabs Text-to-Speech (Human-Like Voice Synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# AI Model Configuration ('free', 'groq', 'gemini', 'openai')
# 'free' uses the built-in free LLM engine (No API key needed!)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here

# Optional Free-Tier API Keys:
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Client Application URL (Set to your Vercel deployment domain, e.g. https://talk-pilot-ai.vercel.app)
CLIENT_URL=https://your-talkpilot.vercel.app
