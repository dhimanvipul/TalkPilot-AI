# TalkPilot AI Configuration Example

# Server & Database Settings
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/talkpilot
JWT_SECRET=your_jwt_secret_key_here

# Telephony Calling Mode ('mock' for zero-cost testing, 'real' for actual PSTN phone calls)
CALLING_MODE=mock

# Telephony Provider Configuration
TELEPHONY_PROVIDER=twilio

# Twilio Credentials (REQUIRED when CALLING_MODE=real)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Public HTTPS Webhook URL (REQUIRED for Twilio status/voice webhooks in real mode)
PUBLIC_WEBHOOK_URL=https://your-public-domain.com

# ElevenLabs Text-to-Speech (Human-Like Voice Synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# AI Model Configuration ('free', 'groq', 'gemini', 'openai')
# 'free' uses the built-in free LLM engine (No API key needed!)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here

# Optional Free-Tier API Keys:
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Client Application URL
CLIENT_URL=http://localhost:3000
